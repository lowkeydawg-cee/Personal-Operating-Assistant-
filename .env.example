# Copy this file to .env and fill in what you use.

# Cloud brain (fast, free tier): get a key at https://console.groq.com/keys
# This is the same key Jarvis uses.
GROQ_API_KEY=

# hybrid = cloud first, local Ollama as backup (default)
# cloud  = cloud only
# local  = Ollama only, nothing leaves this computer
# POA_PROVIDER=hybrid

# Cloud settings. Any OpenAI-compatible API works (Groq, OpenRouter, OpenAI...).
# POA_CLOUD_BASE_URL=https://api.groq.com/openai/v1
# POA_CLOUD_MODEL=llama-3.3-70b-versatile
# POA_CLOUD_API_KEY_ENV=GROQ_API_KEY

# Local brain (Ollama). Pick a model that supports tool calling.
# POA_OLLAMA_HOST=http://localhost:11434
# POA_LOCAL_MODEL=llama3.1:8b

# Other
# PORT=3000
# POA_DATA_FILE=./data/poa.json
