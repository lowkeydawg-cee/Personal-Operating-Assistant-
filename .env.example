# Copy this file to .env and fill in the keys you have. One is enough to start;
# with all three, P.O.A uses each brain where it is strongest.

# Claude: best for reviews, planning and decisions ("Think deeper").
# Paid per use. Key from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Groq: fast and free for everyday chat. Same key as Jarvis.
# Key from https://console.groq.com/keys
GROQ_API_KEY=

# Ollama runs on your computer for Private mode and as the last backup.
# Install from https://ollama.com, then: ollama pull llama3.1:8b

# smart  = Claude for deep work, Groq for quick replies, each backing up the other (default)
# claude = Claude first for everything
# groq   = Groq first, never Claude
# local  = Ollama only, nothing leaves this computer
# POA_PROVIDER=smart

# Claude settings
# POA_CLAUDE_MODEL=claude-opus-5-5
# POA_CLAUDE_EFFORT=medium        # low | medium | high (higher = deeper and slower)

# Groq or any OpenAI-compatible API (OpenRouter, OpenAI...)
# POA_CLOUD_BASE_URL=https://api.groq.com/openai/v1
# POA_CLOUD_MODEL=llama-3.3-70b-versatile
# POA_CLOUD_API_KEY_ENV=GROQ_API_KEY

# Ollama (pick a model that supports tool calling)
# POA_OLLAMA_HOST=http://localhost:11434
# POA_LOCAL_MODEL=llama3.1:8b

# Other
# PORT=3000
# POA_DATA_FILE=./data/poa.json
